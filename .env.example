# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string. Railway auto-injects this in production (Postgres
# plugin); for local dev point it at a local Postgres instance.
DATABASE_URL=postgresql://user:password@localhost:5432/qa_pulse

# Anthropic API key, used by tools/claude_tag_topics.py for topic extraction.
ANTHROPIC_API_KEY=

# Shared secret required on POST /api/ingest (header X-Ingest-Secret). Generate with
# e.g. `openssl rand -hex 32`. Must match between the web service and the
# ingest-cron service — see workflows/deploy_railway.md.
INGEST_SECRET=

# Reddit OAuth app credentials (script app type), used by tools/fetch_source.py's
# fetch_reddit(). Reddit's anonymous JSON endpoint blocks datacenter/cloud-host IPs
# outright, so the Reddit sources require an authenticated client — create a free
# app at https://www.reddit.com/prefs/apps (type: script) to get these.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Google OAuth client (Web application type) used for dashboard sign-in — see
# workflows/deploy_railway.md "Google Sign-In setup" for how to create these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie (app/auth.py). Generate with e.g. `openssl rand -hex 32`.
# MUST be set explicitly in Railway — without it, a random key is generated on every
# boot and everyone gets logged out on each deploy/restart.
SESSION_SECRET_KEY=

# Comma-separated Gmail address(es) allowed to sign in. Anyone else who successfully
# authenticates with Google still gets rejected — this is what actually restricts
# the dashboard, not the Google sign-in step itself.
ALLOWED_EMAILS=

# Port the app listens on. Railway sets this automatically; only needed locally.
PORT=8000
